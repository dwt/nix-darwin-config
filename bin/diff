#!/usr/bin/env bash

set -eo pipefail

# Sandbox doesn't work because closure too large, https://git.lix.systems/lix-project/lix/issues/1304
# re-enable as soon as there is a version of nix that doesn't fail with sandbox enabled
darwin-rebuild build --flake . --option sandbox false "$@" 2>&1 | nom

# shows version diffs
nvd -- diff /run/current-system result
# TODO investigate dix for diffing speed https://github.com/faukah/dix

# if I ever want the history what changed over all profiles I kept
# Most of the stuff this flake installs is kept in this profile
#nix profile diff-closures --profile /nix/var/nix/profiles/system
#nix profile diff-closures --profile /nix/var/nix/profiles/default
#nix profile diff-closures --profile /nix/var/nix/profiles/per-user/root/profile
